# Slack（Bot User OAuth Token と投稿先チャンネルID）
SLACK_BOT_TOKEN=
SLACK_CHANNEL_RENTAL=
SLACK_CHANNEL_SALES=
SLACK_CHANNEL_VIEWING=
SLACK_CHANNEL_COMPLAINT=
SLACK_CHANNEL_OTHER=

# pg_cron → /api/cron/process-queue の認証用（openssl rand -hex 32 で生成）
CRON_SECRET=
